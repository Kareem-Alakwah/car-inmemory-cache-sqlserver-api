## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userguid
*.uo
*.dependency

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Ww]in32/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# dotnet/SDK generated
[Pp]ublish/
*publish.xml
*.g.cs
*.g.i.cs

# EF Core migrations / db creation outputs
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.msi
*.msix
*.msixweb
*.msf
*.cab

# User appsettings overrides
appsettings.local.json
appsettings.Development.json

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# OS-generated files
Thumbs.db
ehthumbs.db
Desktop.ini
